  "contracts": {
    "vabench": {
      "prompt": "You are currently a robot performing robotic manipulation tasks. The task instruction is: {instruction}. Use 2D points to mark the target location where the object you need to manipulate in the task should ultimately be moved. Your answer should be wrapped in <Answer><point>[[x1,y1],[x2,y2],[x3,y3],[x4,y4],[x5,y5],[x6,y6],[x7,y7],[x8,y8]]</point></Answer>, where each coordinate is a decimal between 0 and 1, normalized to the image width and height.",
      "answer_schema": "point01_xml8",
      "point_count": 8,
      "coord_mode": "normalized_0_1",
      "parser_source": "vabench_parser",
      "runtime_config_source": "vabench_runtime_config"
    },
    "where2place": {
      "prompt": "You are an agent who reasons about free space and spatial relations. {question} Your answer should be formatted as a list of tuples, i.e. [(x1, y1), (x2, y2), ...], where each tuple contains the x and y coordinates of a point satisfying the conditions above.",
      "answer_schema": "point01_tuple_list",
      "point_count": "variable_1_2_3_in_training_no_count_instruction",
      "coord_mode": "normalized_0_1",
      "parser_source": "w2p_parser",
      "runtime_config_source": "w2p_runtime_config"
    },
    "vsi_numeric": {
      "prompt": "These are frames of a video.\n{question}\nPlease answer the question using a single word or phrase.",
      "answer_schema": "numeric_or_short_phrase"
    },
    "vsi_mcq": {
      "prompt": "These are frames of a video.\n{question}\nOptions:\n{options}\nAnswer with the option's letter from the given choices directly.",
      "answer_schema": "single_A_D"
    },
    "cosmos": {
      "prompt": "{question}\n{paren_options}\nAnswer with the option's letter from the given choices directly.",
      "answer_schema": "single_A_D"
    },
    "emspatial": {
      "prompt": "{question}\n\nOptions:\n{letter_dot_options}\n\nPlease select the correct answer (A, B, C, or D).\n",
      "answer_schema": "single_A_D"
    },
    "erqa": {
      "prompt": "{question_with_choices} Please answer directly with only the letter of the correct option and nothing else.",
      "answer_schema": "single_A_D"
    },
    "openeqa": {
      "prompt": "{question}",
      "answer_schema": "concise_open_text"
